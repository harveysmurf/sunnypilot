[Unit]
Description=Power/shutdown evidence logger (writes fsynced power snapshots to /data/power-debug)
After=local-fs.target
Before=comma.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONPATH=/data/openpilot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/venv/bin/python /data/openpilot/tools/power-debug/power_logger.py
ExecStop=/bin/sh -c 'echo "$(date -Is) SYSTEM_SHUTDOWN power-debug stopped by systemd (graceful halt/reboot)" >> /data/power-debug/events.log; sync -f /data/power-debug/events.log || true'
Restart=always
RestartSec=2
Nice=-5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
